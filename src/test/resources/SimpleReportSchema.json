{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "validationReport": {
      "type": "object",
      "properties": {
        "validationConclusion": {
          "type": "object",
          "properties": {
            "validationTime": {
              "type": "string",
              "format": "date-time",
              "minLength": 1
            },
            "signaturesCount": {
              "type": "integer",
              "minimum": 0
            },
            "signatureForm": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "DIGIDOC_XML_1.0",
                "DIGIDOC_XML_1.0_hashcode",
                "DIGIDOC_XML_1.1",
                "DIGIDOC_XML_1.1_hashcode",
                "DIGIDOC_XML_1.2",
                "DIGIDOC_XML_1.2_hashcode",
                "DIGIDOC_XML_1.3",
                "DIGIDOC_XML_1.3_hashcode",
                "ASiC-E",
                "ASiC-S",
                null
              ]
            },
            "validSignaturesCount": {
              "type": "integer",
              "minimum": 0
            },
            "validatedDocument": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "fileHash": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "hashAlgo": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "signatures": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "signatureFormat": {
                    "type": "string",
                    "enum": [
                      "XAdES_BASELINE_B",
                      "XAdES_BASELINE_B_BES",
                      "XAdES_BASELINE_B_EPES",
                      "XAdES_BASELINE_T",
                      "XAdES_BASELINE_LT",
                      "XAdES_BASELINE_LT_TM",
                      "XAdES_BASELINE_LTA",
                      "CAdES_BASELINE_B",
                      "CAdES_BASELINE_T",
                      "CAdES_BASELINE_LT",
                      "CAdES_BASELINE_LTA",
                      "PAdES_BASELINE_B",
                      "PAdES_BASELINE_T",
                      "PAdES_BASELINE_LT",
                      "PAdES_BASELINE_LTA",
                      "SK_XML_1.0",
                      "DIGIDOC_XML_1.1",
                      "DIGIDOC_XML_1.2",
                      "DIGIDOC_XML_1.3"
                    ]
                  },
                  "signatureMethod": {
                    "type": "string",
                    "minLength": 1
                  },
                  "signedBy": {
                    "type": "string",
                    "minLength": 1
                  },
                  "claimedSigningTime": {
                    "type": "string",
                    "format": "date-time",
                    "minLength": 1
                  },
                  "signatureLevel": {
                    "type": "string",
                    "minLength": 1
                  },
                  "subjectDistinguishedName": {
                    "type": "object",
                    "properties": {
                      "serialNumber": {
                        "type": "string",
                        "minLength": 1
                      },
                      "commonName": {
                        "type": "string",
                        "minLength": 1
                      },
                      "givenName": {
                        "type": "string",
                        "minLength": 1
                      },
                      "surname": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  "warnings": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "content": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "content"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "signatureScopes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "content": {
                          "type": "string",
                          "minLength": 1
                        },
                        "scope": {
                          "type": "string",
                          "minLength": 1
                        },
                        "hashAlgo": {
                          "type": "string",
                          "minLength": 1
                        },
                        "hash": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "scope",
                        "name",
                        "content"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "indication": {
                    "type": "string",
                    "enum": [
                      "TOTAL-PASSED",
                      "TOTAL-FAILED",
                      "INDETERMINATE"
                    ]
                  },
                  "subIndication": {
                    "type": "string",
                    "minLength": 1
                  },
                  "errors": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "content": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "content"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "info": {
                    "type": "object",
                    "properties": {
                      "bestSignatureTime": {
                        "type": "string",
                        "format": "date-time",
                        "minLength": 1
                      },
                      "timeAssertionMessageImprint": {
                        "type": "string",
                        "minLength": 1
                      },
                      "ocspResponseCreationTime": {
                        "type": "string",
                        "minLength": 1
                      },
                      "timestampCreationTime": {
                        "type": "string",
                        "minLength": 1
                      },
                      "signerRole": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "properties": {
                            "claimedRole": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "claimedRole"
                          ]
                        }
                      },
                      "signatureProductionPlace": {
                        "type": "object",
                        "properties": {
                          "countryName": {
                            "type": "string",
                            "minLength": 1
                          },
                          "stateOrProvince": {
                            "type": "string",
                            "minLength": 1
                          },
                          "city": {
                            "type": "string",
                            "minLength": 1
                          },
                          "postalCode": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "signingReason": {
                        "type": "string",
                        "minLength": 1
                      },
                      "archiveTimeStamps": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "properties": {
                            "signedTime": {
                              "type": "string",
                              "format": "date-time",
                              "minLength": 1
                            },
                            "indication": {
                              "type": "string",
                              "enum": [
                                "PASSED",
                                "FAILED",
                                "NO_SIGNATURE_FOUND"
                              ]
                            },
                            "subIndication": {
                              "type": "string",
                              "minLength": 1
                            },
                            "signedBy": {
                              "type": "string",
                              "minLength": 1
                            },
                            "country": {
                              "type": "string",
                              "minLength": 1
                            },
                            "content": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "signedTime",
                            "indication",
                            "signedBy",
                            "country",
                            "content"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "bestSignatureTime"
                    ],
                    "additionalProperties": false
                  },
                  "certificates": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "commonName": {
                          "type": "string",
                          "minLength": 1
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "SIGNING",
                            "REVOCATION",
                            "SIGNATURE_TIMESTAMP",
                            "ARCHIVE_TIMESTAMP",
                            "CONTENT_TIMESTAMP"
                          ]
                        },
                        "content": {
                          "type": "string",
                          "minLength": 1
                        },
                        "issuer": {
                          "type": "object",
                          "properties": {
                            "commonName": {
                              "type": "string",
                              "minLength": 1
                            },
                            "content": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "commonName",
                            "content"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "commonName",
                        "type",
                        "content"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "signatureFormat",
                  "signatureMethod",
                  "signedBy",
                  "claimedSigningTime",
                  "signatureScopes",
                  "id",
                  "indication"
                ],
                "additionalProperties": false
              }
            },
            "timeStampTokens": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "signedTime": {
                    "type": "string",
                    "minLength": 1
                  },
                  "certificates": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "commonName": {
                          "type": "string",
                          "minLength": 1
                        },
                        "type": {
                          "type": "string",
                          "minLength": 1
                        },
                        "content": {
                          "type": "string",
                          "minLength": 1
                        },
                        "issuer": {
                          "type": "object",
                          "properties": {
                            "commonName": {
                              "type": "string",
                              "minLength": 1
                            },
                            "content": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "commonName",
                            "content"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "commonName",
                        "type",
                        "content"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "signedBy": {
                    "type": "string",
                    "minLength": 1
                  },
                  "indication": {
                    "type": "string",
                    "minLength": 1
                  },
                  "timestampScopes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "scope": {
                          "type": "string",
                          "minLength": 1
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "content": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "scope",
                        "name",
                        "content"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "timestampLevel": {
                    "type": "string",
                    "minLength": 1
                  },
                  "error": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "content": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "content"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "errors": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "content": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "content"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "warning": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "content": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "content"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "warnings": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "content": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "content"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "subIndication": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "signedTime",
                  "certificates",
                  "signedBy",
                  "indication"
                ],
                "additionalProperties": false
              }
            },
            "policy": {
              "type": "object",
              "properties": {
                "policyDescription": {
                  "type": "string",
                  "minLength": 1
                },
                "policyUrl": {
                  "type": "string",
                  "minLength": 1,
                  "format": "uri"
                },
                "policyName": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "policyDescription",
                "policyUrl",
                "policyName"
              ],
              "additionalProperties": false
            },
            "validationLevel": {
              "type": "string",
              "enum": [
                "ARCHIVAL_DATA"
              ]
            },
            "validationWarnings": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "content"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "validationTime",
            "signaturesCount",
            "validSignaturesCount",
            "policy"
          ]
        }
      },
      "required": [
        "validationConclusion"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "validationReport"
  ],
  "additionalProperties": false
}
